[Unit]
Description=SOCKS server (dante) - Maxinet
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/sockd.pid
ExecStart=/usr/sbin/danted -f /etc/dante/sockd.conf -p /run/sockd.pid -D
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
